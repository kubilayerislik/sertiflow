{
  "name": "sertiflow",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev -p 3000",
    "build": "prisma generate && node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.0",
    "@node-saml/node-saml": "^5.1.0",
    "@pdfme/pdf-lib": "^6.1.2",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.62.8",
    "argon2": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.13",
    "fontkit": "^2.0.4",
    "jose": "^5.9.6",
    "lucide-react": "^1.61.0",
    "next": "^15.1.3",
    "node-cron": "^3.0.3",
    "nodemailer": "10.2.1",
    "pdfjs-dist": "^4.9.155",
    "postcss": "^8.5.31",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.90.0",
    "react-rnd": "^10.4.14",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
